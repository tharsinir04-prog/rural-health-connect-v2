{
  "name":"rural-health-connect-server",
  "private":true,
  "type":"module",
  "scripts":{
    "dev":"tsx watch src/index.ts",
    "build":"tsc",
    "start":"node dist/index.js",
    "db:generate":"prisma generate",
    "db:migrate":"prisma migrate dev --name init",
    "db:seed":"tsx prisma/seed.ts",
    "test":"vitest run"
  },
  "dependencies":{
    "@prisma/client":"^6.15.0",
    "bcryptjs":"^3.0.2",
    "cors":"^2.8.5",
    "dotenv":"^17.2.1",
    "express":"^5.1.0",
    "express-rate-limit":"^8.0.1",
    "helmet":"^8.1.0",
    "jsonwebtoken":"^9.0.2",
    "socket.io":"^4.8.1",
    "zod":"^4.0.17"
  },
  "devDependencies":{
    "@types/bcryptjs":"^2.4.6",
    "@types/cors":"^2.8.19",
    "@types/express":"^5.0.3",
    "@types/jsonwebtoken":"^9.0.10",
    "@types/node":"^24.3.0",
    "prisma":"^6.15.0",
    "tsx":"^4.20.4",
    "typescript":"^5.9.2",
    "vitest":"^3.2.4",
    "supertest":"^7.1.4",
    "@types/supertest":"^6.0.3"
  }
}